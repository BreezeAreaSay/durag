# ---------------------------------------------------------------------------
# Copy to `.env` (never commit `.env`). Used by docker-compose and the backend.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather. Required to validate Telegram initData.
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Allow "dev" logins (no Telegram signature) for local testing in a browser.
# NEVER enable in production.
ALLOW_DEV_AUTH=true

# Backend listen port.
PORT=8080

# Redis connection (host:port). Leave empty to use the in-memory store
# (single backend instance only, state is lost on restart).
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Comma separated list of allowed WebSocket origins ("*" = any).
ALLOWED_ORIGINS=*

# How long an idle room is kept in Redis.
ROOM_TTL=24h

# Maximum age of Telegram initData (replay protection). 0 disables the check.
TG_INITDATA_MAX_AGE=24h

# How long a finished bout stays on the table (so everybody sees what beat what).
BOUT_RESOLVE_DELAY=3500ms

# After a bout, how long a player gets to take their stump (TAKE_STUMP) before
# the server does it for them.
STUMP_AUTO_DELAY=4s

# Attack cards per bout (classic 6). 0 = only the defender's hand limits the table.
MAX_ATTACKS=6

# Turn timer: idle players get a default move after this (attacker leads the
# lowest card, defender takes, throwers pass). 0 disables the timer.
TURN_TIMEOUT=45s

# ---- bots (spec v10 §2) ----
# Bots are available in the lobby ("+ ADD A BOT"). Without a key they play by
# built-in rules; with a key they ask a chat model for every move.
BOTS=true
# Paste your OpenRouter key here (https://openrouter.ai/keys, starts with sk-or-).
# Any OpenAI-compatible endpoint works: DeepSeek, Qwen/DashScope, etc.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Models tried in order (comma separated). "openrouter/free" = whichever free
# model OpenRouter has right now; concrete ":free" ids rotate without notice.
# Free tier: 20 requests/min and 50/day until the account has ever bought $10
# of credits (then 1000/day); past the quota the bots play by the built-in
# rules until the pause ends. Paid but cheap and stable: deepseek/deepseek-chat.
LLM_MODEL=openrouter/free
# Safety catch: paid model ids in LLM_MODEL are dropped while this is true, so
# the key cannot spend money by accident. Set to false to allow a paid fallback.
LLM_FREE_ONLY=true
# How long a bot may think before falling back to the built-in rules.
LLM_TIMEOUT=10s
# Human-like pause before a bot moves.
BOT_DELAY_MIN=900ms
BOT_DELAY_MAX=2200ms

# ---- production only (docker-compose.prod.yml) ----
# Public domain name pointing at this host (for Nginx + Let's Encrypt).
DOMAIN=durag.example.com
# E-mail used by Certbot for expiry notices.
CERTBOT_EMAIL=admin@example.com

# ---- frontend build (baked in at build time) ----
# Bot username (without @) and the Mini App short name from @BotFather /newapp.
# Used to build deep links: https://t.me/<bot>/<app>?startapp=<TABLE CODE>
VITE_BOT_USERNAME=
VITE_APP_SHORTNAME=
